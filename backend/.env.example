# PotSpot API -- Environment Configuration
#
# Copy this file to .env and fill in values.
# Never commit .env to version control.

# Database
DATABASE_URL=postgres://potspot:potspot_dev@localhost:5432/potspot

# JWT
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-at-least-64-chars

# MinIO / S3-compatible object storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=potspot-photos

# OAuth providers (leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Server
HOST=0.0.0.0
PORT=3000

# Public URL of this API server (used for OAuth redirect URIs)
# Defaults to http://localhost:3000 in development
# Set to https://api.yourdomain.com in production
PUBLIC_URL=http://localhost:3000

# Logging
RUST_LOG=info

# CORS allowed origin (frontend URL)
CORS_ORIGIN=http://localhost:5173
