# PotSpot -- Environment Variables
# Copy to .env and fill in your values before running docker compose.
#
#   cp .env.example .env

# --- Domain & Ports ---
PUBLIC_URL=https://potspot.example.com
CORS_ORIGIN=https://potspot.example.com
# Change these if ports 80/443 are already in use (e.g. by NPM/nginx)
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# --- PostgreSQL ---
POSTGRES_USER=potspot
POSTGRES_PASSWORD=generate-a-strong-random-password-here
POSTGRES_DB=potspot
DATABASE_URL=postgres://potspot:CHANGE_ME@db:5432/potspot

# --- JWT Secrets (generate with: openssl rand -hex 32) ---
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string

# --- MinIO (Object Storage) ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-to-a-random-secret

# --- OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Logging ---
RUST_LOG=info
